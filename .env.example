# ---- required -------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ---- sandbox --------------------------------------------------------------
# Where the agents write and run code. Wiped at the start of every run.
# CREW_SANDBOX=./sandbox

# The container the generated code executes in. Pinned on purpose: agents write
# against whatever Python they are told is present, so drifting this silently
# changes what "the tests passed" means.
# CREW_DOCKER_IMAGE=ghcr.io/astral-sh/uv:python3.13-bookworm-slim
# CREW_SANDBOX_PYTHON=3.13

# A generated script that has not finished in this long is killed.
# CREW_EXECUTION_TIMEOUT_S=300

# ---- documentation MCP ----------------------------------------------------
# The lead and frontend engineer query Context7 for current library APIs, so the
# design is written against real Gradio 6 signatures rather than recollection.
# USE_CONTEXT7=true
# CONTEXT7_MCP_URL=https://mcp.context7.com/mcp
